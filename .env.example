GEMINI_API_KEY=your_gemini_api_key_here
ASSEMBLY_AI_API_KEY=your_assemblyai_api_key_here

# Hosting / access control (leave unset for local dev — gate is disabled when unset)
INVITE_CODE=choose_a_secret_passphrase
SECRET_KEY=choose_a_long_random_string

# Optional: override default rate limit (default: 10 per hour per IP)
# RATE_LIMIT=10 per hour

# YouTube cookie auth — required on hosted/cloud deployments where YouTube blocks bot IPs.
# Export cookies from your browser in Netscape format and paste the full file contents here.
# See: https://github.com/yt-dlp/yt-dlp/wiki/FAQ#how-do-i-pass-cookies-to-yt-dlp
# YOUTUBE_COOKIES=
