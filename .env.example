GEMINI_API_KEY=your_gemini_api_key_here
ASSEMBLY_AI_API_KEY=your_assemblyai_api_key_here

# Hosting / access control (leave unset for local dev — gate is disabled when unset)
INVITE_CODE=choose_a_secret_passphrase
SECRET_KEY=choose_a_long_random_string

# Optional: override default rate limit (default: 10 per hour per IP)
# RATE_LIMIT=10 per hour

# Residential proxy list for YouTube downloads — required on hosted/cloud deployments
# where YouTube blocks datacenter IPs. Newline-separated socks5:// URLs, one per line.
# Leave unset for local dev (your home IP is residential already).
# YTDLP_PROXIES=socks5://user:pass@host:port
